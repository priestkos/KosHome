<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>1.0.0</Version>
    <Description>One home for the PriestKos plugin tools: Aetherpath, Calc14, FrontlineAdvisor, GateAlert, KeyLock, NameplateOffset, Quill14, VenueLedger, Wardrobe14 and WorldClock14 as apps you switch on and off from one window.</Description>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <PropertyGroup>
    <Author>PriestKos</Author>
    <Authors>PriestKos</Authors>
    <Name>KosHome</Name>
    <Punchline>One home for the PriestKos plugin tools.</Punchline>
    <RepoUrl>https://github.com/priestkos/KosHome</RepoUrl>
    <Tags>utility;ui</Tags>
    <IconUrl>https://raw.githubusercontent.com/priestkos/KosHome/main/images/icon.png</IconUrl>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Host.Tests" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="tests/**" />
    <None Remove="tests/**" />
    <!-- KosLib submodule: compile its sources only, never its tests or nested obj/ -->
    <Compile Remove="KosLib/**" />
    <None Remove="KosLib/**" />
    <Compile Include="KosLib/src/**/*.cs" />
    <!-- App tiles: each original plugin's icon, 128 px -->
    <EmbeddedResource Include="Assets\Apps\*.png" LogicalName="apps.%(Filename).png" />
    <!-- Dalamud shows a dev plugin's icon from images/icon.png beside the DLL -->
    <Content Include="images\icon.png" Link="images\icon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </Content>
    <Content Include="Apps\Quill14\Data\words.txt.gz" Link="Data\words.txt.gz">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Penumbra.Api" Version="5.19.2" />
    <PackageReference Include="Glamourer.Api" Version="2.8.2" />
  </ItemGroup>
</Project>
